<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>
  <servlet>
  	<servlet-name>ImageProcessor</servlet-name>
  	<display-name>ImageProcessor</display-name>
  	<description></description>
  	<servlet-class>com.org.servlet.ImageProcessor</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>HierarchicalFirstLevelData</servlet-name>
  	<display-name>HierarchicalFirstLevelData</display-name>
  	<description></description>
  	<servlet-class>com.org.servlet.HierarchicalFirstLevelData</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>HierarchicalNonFirstLevelData</servlet-name>
  	<display-name>HierarchicalNonFirstLevelData</display-name>
  	<description></description>
  	<servlet-class>com.org.servlet.HierarchicalNonFirstLevelData</servlet-class>
  </servlet>
  <servlet-mapping>
  	<servlet-name>ImageProcessor</servlet-name>
  	<url-pattern>/imageProcessor</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>HierarchicalFirstLevelData</servlet-name>
  	<url-pattern>/hierarchicalFirstLevelData</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>HierarchicalNonFirstLevelData</servlet-name>
  	<url-pattern>/hierarchicalNonFirstLevelData</url-pattern>
  </servlet-mapping>
</web-app>
